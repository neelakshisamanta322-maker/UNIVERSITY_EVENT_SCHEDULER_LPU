# =============================================================================
# LPU Event Scheduling & Resource Optimization Matrix
# Environment Configuration — Copy to .env and fill in real values
# NEVER commit .env to version control
# =============================================================================

# ---------------------------------------------------------------------------
# SECURITY (required in production)
# ---------------------------------------------------------------------------

# Set to "true" when deployed behind HTTPS to mark cookies as Secure.
# Leave "false" for local HTTP development only.
SECURE_COOKIE=false

# Authorized CORS origins (comma-separated).
# Wildcards are rejected when allow_credentials=True.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# DEMO MODE (default: disabled)
# ---------------------------------------------------------------------------

# Set to "true" only for demos/presentations. Seeding demo accounts with
# default credentials will occur on first startup when no users exist.
# NEVER enable in production.
DEMO_MODE=false

# ---------------------------------------------------------------------------
# TESTING MODE (default: disabled)
# ---------------------------------------------------------------------------

# Set to "true" only for automated test suites running in a CI environment.
# Enables the X-User-Role mock header for headless test clients.
# NEVER enable in production.
TESTING_MODE=false

# ---------------------------------------------------------------------------
# ADMIN ACCOUNT PROVISIONING (optional)
# ---------------------------------------------------------------------------

# If set, admin accounts (neelakshisamanta322@gmail.com and
# abhay.sharma197125@gmail.com) are provisioned with this password on the
# first startup when no users exist in the database.
# Once accounts are created, this variable has no further effect.
# Remove from environment after first startup for security.
# ADMIN_INITIAL_PASSWORD=

# ---------------------------------------------------------------------------
# SMTP / EMAIL DELIVERY (required for 2FA, password reset)
# ---------------------------------------------------------------------------

# Without SMTP configuration, Admin 2FA OTP and password reset emails will
# not be delivered. The application will inform users honestly rather than
# claiming delivery. Required for production use.

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=LPU Identity Services <noreply@lpu.in>

# ---------------------------------------------------------------------------
# NOTES
